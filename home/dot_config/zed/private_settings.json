// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  // Presentation settings
  "markdown_preview": {
    "open_markdown_files_in_preview": false
  },
  "cli_default_open_behavior": "new_window",
  "language_models": {
    "opencode": {
      "show_go_models": false,
      "show_zen_models": false
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "colorize_brackets": false,
  "sticky_scroll": {
    "enabled": true
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "ui_font_size": 15,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13,
  "terminal": {
    "font_family": "MesloLGS Nerd Font",
    "font_size": 13,
    "line_height": "standard",
    "blinking": "on"
  },
  "show_whitespaces": "all",
  "minimap": { "show": "always", "current_line_highlight": "all" },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors"
  },
  "outline_panel": {
    "dock": "right"
  },
  "soft_wrap": "editor_width",
  "wrap_guides": [120],
  "scrollbar": { "axes": { "horizontal": false } },

  // General
  "auto_update": true,
  "base_keymap": "VSCode",

  "languages": {
    "Markdown": {
      "completions": { "words": "disabled" },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "ruff" } }]
    },
    "Go": {
      "language_servers": ["gopls", "golangci-lint"],
      "format_on_save": "on",
      "formatter": [
        {
          "external": {
            "command": "golangci-lint",
            "arguments": ["fmt", "--stdin"]
          }
        }
      ]
    },
    "JSON": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSONC": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    }
  },
  "lsp": {
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "experimental": {
          "classRegex": [
            // tailwind-variant
            ["tv\\({([^]*?)}\\)", "[\"'`]([^\"'`]*)[\"'`]"],
            // clsx
            ["clsx\\(((?:[^()]|\\([^()]*\\))*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
          ]
        }
      }
    },
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path="
        ]
      }
    }
  },
  "inlay_hints": {
    "show_background": false,
    "enabled": false,
    "toggle_on_modifiers_press": { "control": true, "alt": true }
  },
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 300,
      "padding": 4,
      "min_column": 0,
      "max_severity": null
    }
  },

  // AI
  "edit_predictions": {
    "zed": {
      "prediction_debounce": 500
    },
    "provider": "zed",
    "mode": "subtle"
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    },
    "model_parameters": []
  },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "mode": "plan"
      },
      "type": "registry"
    }
  }
}
